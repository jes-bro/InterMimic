+        meshes_root=None, obj_color=None, human_color=None):
   """Load the SMPL part-texture body and the object as one textured scene.
 
   obj_color, an (r, g, b) in 0-255, replaces the object's texture with that
   flat colour. A metal pot rendered with its own texture over a kitchen is
   invisible in the visualization; a magenta one is not. Rendering only --
   nothing that optimizes against the texture should pass it.
+  human_color does the same for the body (replaces the part texture), so a
+  simulated rollout overlaid on the source video reads as ONE flat figure --
+  human and object in a single colour -- against the real footage.
   """
   from pytorch3d.structures import join_meshes_as_scene, join_meshes_as_batch
   from pytorch3d.renderer import TexturesUV
@@ -137,6 +140,19 @@ def load_smpl_obj_uvmap(video_prefix, use_hy3d=False, seq_name=None, human_textu
   print('loading templates from', files)
   meshes = load_objs_as_meshes(files, device='cuda')
 
+  def _flat(m, rgb):
+    maps = m.textures.maps_padded()
+    flat = torch.tensor(rgb, dtype=maps.dtype, device=maps.device).view(1, 1, 1, 3) / 255.0
+    return Meshes(verts=m.verts_list(), faces=m.faces_list(),
+                  textures=TexturesUV(maps=flat.expand_as(maps).contiguous(),
+                                      faces_uvs=m.textures.faces_uvs_padded(),
+                                      verts_uvs=m.textures.verts_uvs_padded()))
+
+  if human_color is not None:
+    rest = [meshes[i] for i in range(1, len(meshes))]
+    meshes = join_meshes_as_batch([_flat(meshes[0], human_color)] + rest) if rest else _flat(meshes[0], human_color)
+    print('human rendered in flat colour', tuple(human_color))
+
   if obj_color is not None and not hum_only:
     obj = meshes[1]
     maps = obj.textures.maps_padded()
